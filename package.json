{
  "name": "dsa-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Laboratorio interactivo para aprender estructuras de datos y algoritmos mediante visualizaciones y código Java y C++.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanideus/DATA-STRUCTURS.git"
  },
  "bugs": {
    "url": "https://github.com/juanideus/DATA-STRUCTURS/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo.mjs",
    "preview": "vite preview",
    "audit": "node scripts/audit-functions.mjs",
    "audit:structures": "node scripts/audit-structure-fidelity.mjs",
    "audit:challenges": "node scripts/audit-challenges.mjs",
    "audit:section-tests": "node scripts/audit-section-tests.mjs",
    "audit:java": "node scripts/compile-java-audit.mjs",
    "audit:java-standalone": "node scripts/runtime-java-standalone.mjs",
    "audit:java-runtime": "node scripts/runtime-java-multiway.mjs",
    "audit:java-red-black": "node scripts/runtime-java-red-black.mjs",
    "audit:cpp": "node scripts/compile-cpp-audit.mjs",
    "audit:cpp-runtime": "node scripts/runtime-cpp-audit.mjs",
    "audit:threaded-header": "node scripts/runtime-threaded-header-audit.mjs",
    "audit:stress": "node scripts/stress-audit.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate && npm --prefix report audit --audit-level=moderate",
    "test:report": "npm --prefix report test",
    "test:secrets": "node --test scripts/secret-scanner.test.mjs",
    "test:security-client": "node --test tests/security/*.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check": "npm run test:secrets && npm run test:security-client && npm run audit:secrets && npm run audit:dependencies && npm run test:report && npm run audit && npm run audit:structures && npm run audit:challenges && npm run audit:section-tests && npm run audit:java && npm run audit:java-standalone && npm run audit:java-runtime && npm run audit:java-red-black && npm run audit:cpp && npm run audit:cpp-runtime && npm run audit:threaded-header && npm run audit:stress && npm run build && node scripts/audit-secrets.mjs --artifacts-only && npm run audit:seo && npm run test:e2e"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "postcss": "8.5.26",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "^22.23.3 || ^24.22.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.8.0"
}
