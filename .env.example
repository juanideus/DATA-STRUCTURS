# URL pública de la API `report` desplegada en Railway, sin barra final.
# Esta variable es pública: nunca escribas aquí RESEND_API_KEY ni otros secretos.
VITE_REPORT_API_URL=https://api.dsalab.dev

# Clave pública del widget Turnstile. Puede exponerse en el frontend.
# Si se omite, el widget permanece desactivado hasta completar la configuración.
VITE_TURNSTILE_SITE_KEY=
