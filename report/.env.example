# Copia este archivo como .env solamente para desarrollo local.
# En Railway configura estos valores desde la pestaña Variables del servicio.
RESEND_API_KEY=re_reemplazar_en_railway
REPORT_EMAIL=tu-correo-asociado-a-resend@ejemplo.com

# Clave secreta de Turnstile. Nunca debe agregarse al frontend ni a Git.
# Obligatoria: sin esta clave la API rechaza los reportes con 503.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=www.dsalab.dev,dsalab.dev,data-structurs.vercel.app

# Orígenes adicionales, separados por comas. dsalab.dev, www.dsalab.dev y la
# URL histórica de Vercel ya están autorizados de forma segura en el servicio.
ALLOWED_ORIGINS=http://localhost:5173

# Local/directo: socket. En Railway HTTP público: railway-public, únicamente
# en un entorno dedicado sin llamadores privados no confiables ni TCP proxy.
# Railway sobrescribe X-Real-IP en el edge; no publica CIDRs estables.
CLIENT_IP_SOURCE=socket

# Solo para otro reverse proxy con rangos y contrato de cabeceras confirmados:
# CLIENT_IP_SOURCE=trusted-proxy. No combinar con railway-public ni inventar
# rangos; no usar 0.0.0.0/0 o ::/0.
TRUSTED_PROXY_CIDRS=

# Requiere que dsalab.dev aparezca como verificado en Resend.
# Resend no exige crear esta casilla para utilizarla como remitente.
REPORT_FROM=DSA Lab <reportes@dsalab.dev>

# Railway define PORT automáticamente. Este valor sirve para desarrollo local.
PORT=10000

# Agrégala en Railway para rechazar solicitudes sin Origin.
NODE_ENV=production
