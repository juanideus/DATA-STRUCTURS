# Copia este archivo como .env solamente para desarrollo local.
# En Render configura estos valores desde Environment.
RESEND_API_KEY=re_reemplazar_en_render
REPORT_EMAIL=tu-correo-asociado-a-resend@ejemplo.com

# URL pública del frontend. Se pueden separar varios orígenes con comas.
ALLOWED_ORIGINS=http://localhost:5173,https://tu-proyecto.vercel.app

# Resend permite onboarding@resend.dev sin dominio únicamente para enviar
# al correo asociado con la cuenta de Resend.
REPORT_FROM=DSA Lab <onboarding@resend.dev>

# Render define PORT automáticamente. Este valor sirve para desarrollo local.
PORT=10000

# Render ya define NODE_ENV=production en la mayoría de despliegues. Si no
# aparece en tu servicio, agrégala para rechazar solicitudes sin Origin.
NODE_ENV=production
